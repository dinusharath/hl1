# Copy to .env and adjust. The app validates these at boot and fails fast if any are missing.

# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://ingestion:ingestion@localhost:5432/ingestion?schema=public"

# HTTP
PORT=3000

# Worker tuning
WORKER_POLL_INTERVAL_MS=1000   # how often the worker looks for claimable work
WORKER_BATCH_SIZE=10           # forms claimed per tick
WORKER_LEASE_MS=30000          # a PROCESSING row older than this is reclaimed
MAX_ATTEMPTS=5                 # retryable-failure cap before NEEDS_REVIEW
EMAIL_MAX_ATTEMPTS=50          # the confirmation email is "guaranteed" — retry far longer

# Provider simulation (so tests/dev are deterministic instead of Math.random())
GEOCODER_FAILURE_RATE=0.05
EMAIL_FAILURE_RATE=0.05
PROVIDER_TIMEOUT_MS=5000

# Self-healing drift: suggestions at/above this confidence are auto-applied (approved_by='auto');
# below it, a human reviews. Reversible via the mapping's active flag.
AUTO_APPLY_CONFIDENCE=0.95
